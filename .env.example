# Banco de dados: Postgres no Supabase (obrigatório)
# App (local e Vercel): transaction pooler, porta 6543. Copie do painel do Supabase:
#   Connect > Transaction pooler. Usuário no formato postgres.<project-ref>.
#   Substitua [YOUR-PASSWORD] INCLUSIVE os colchetes: senha entre [] falha na autenticação.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-<n>-<regiao>.pooler.supabase.com:6543/postgres

# Migrações (pnpm db:push) e migração de dados: NÃO use o transaction pooler.
# Use a conexão direta (IPv6) ou o session pooler (porta 5432, funciona em IPv4).
# Se ausente, os comandos caem para DATABASE_URL.
DIRECT_URL=postgresql://postgres.<project-ref>:<senha>@aws-<n>-<regiao>.pooler.supabase.com:5432/postgres

# Chave JWT para cookies de sessão
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria

# ID do app (obrigatório: entra no payload da sessão; sem ele o login não se sustenta)
VITE_APP_ID=glme

# Porta do servidor local (padrão: 3000; não usada no Vercel)
PORT=3000

# Certificado digital e-CNPJ A1 (ICP-Brasil) para consultar a inscrição estadual na SEFAZ da UF do importador.
# CERTIFICADO_A1_BASE64 = conteúdo do arquivo .pfx em base64, numa linha só. No PowerShell:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("C:\caminho\certificado.pfx"))
# Opcional: sem ele, a consulta de CNPJ funciona e a inscrição estadual fica para digitar.
# CERTIFICADO_A1_BASE64=
# CERTIFICADO_A1_SENHA=

# Chave de criptografia dos segredos guardados no banco (Client-Secret da chave de acesso do
# Portal Único). 32 bytes em base64, DIFERENTE em cada ambiente. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Sem ela, o app funciona, mas não salva chaves de acesso. Se for trocada, as chaves salvas
# deixam de ser lidas e cada usuário cadastra a sua de novo.
# CHAVE_CRIPTOGRAFIA=

# Ambiente do Portal Único para a consulta da DUIMP pela API: producao (padrão) ou validacao
# (https://val.portalunico.siscomex.gov.br, aberto ao público, para testar sem mexer em dados reais).
# PORTAL_UNICO_AMBIENTE=producao

# Só para `pnpm db:seed` (cria o admin inicial se não existir nenhum)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Só para `pnpm db:migrar-dados` (origem MySQL, uso único)
# MYSQL_URL=mysql://usuario:senha@host:3306/glme
