# Banco de dados: Postgres no Supabase (obrigatório)
# App (local e Vercel): transaction pooler, porta 6543. Copie do painel do Supabase:
#   Connect > Transaction pooler. Usuário no formato postgres.<project-ref>.
DATABASE_URL=postgresql://postgres.<project-ref>:<senha>@aws-<n>-<regiao>.pooler.supabase.com:6543/postgres

# Migrações (pnpm db:push) e migração de dados: NÃO use o transaction pooler.
# Use a conexão direta (IPv6) ou o session pooler (porta 5432, funciona em IPv4).
# Se ausente, os comandos caem para DATABASE_URL.
DIRECT_URL=postgresql://postgres.<project-ref>:<senha>@aws-<n>-<regiao>.pooler.supabase.com:5432/postgres

# Chave JWT para cookies de sessão
JWT_SECRET=troque-por-uma-chave-secreta-aleatoria

# ID do app (obrigatório: entra no payload da sessão; sem ele o login não se sustenta)
VITE_APP_ID=glme

# Porta do servidor local (padrão: 3000; não usada no Vercel)
PORT=3000

# Só para `pnpm db:seed` (cria o admin inicial se não existir nenhum)
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Só para `pnpm db:migrar-dados` (origem MySQL, uso único)
# MYSQL_URL=mysql://usuario:senha@host:3306/glme
