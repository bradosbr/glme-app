{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm run build:vercel",
  "outputDirectory": "dist/public",
  "regions": ["gru1"],
  "functions": {
    "api/trpc/duimp.consultarAPI.js": {
      "maxDuration": 60
    },
    "api/trpc/sefaz.consultarCadastro.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
